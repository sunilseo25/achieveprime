{%- liquid
  if aspect_ratio
    assign cover = true
  else
    assign aspect_ratio = image.aspect_ratio
    assign cover = false
  endif
  assign aspect_ratio = aspect_ratio | at_least: min_aspect_ratio
-%}

<div class="rimage-outer-wrapper" style="max-width: {{ image.width }}px"
  {% if animateZoom %}data-cc-animate="cc-zoom-out"{% endif %}
>
  <div class="rimage-wrapper lazyload--placeholder" style="padding-top:{{ 1 | divided_by: aspect_ratio | times: 100 }}%">
    {% if initial %}
      <img class="rimage__image lazyload fade-in {% if cover %}cover{% endif %}" data-src="{{ image | img_url: initial }}" alt="{{ image.alt | escape }}">
      {% assign initial = false %}
    {% endif %}
    {% assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img class="rimage__image lazyloaded{% if manual_image_load %}--manual{% endif %} fade-in {% if cover %}cover{% endif %}"
      src="{{ image | image_url: width: 100 }}" data-li="st" d-src="{{ image | image_url: width: 800 }}"
      dt="
        {{ image | image_url: width: 460 }} 460w,
        {{ image | image_url: width: 540 }} 540w,
        {{ image | image_url: width: 720 }} 720w,
        {{ image | image_url: width: 900 }} 900w,
        {{ image | image_url: width: 1080 }} 1080w,
        {{ image | image_url: width: 1296 }} 1296w,
        {{ image | image_url: width: 1512 }} 1512w,
        {{ image | image_url: width: 1728 }} 1728w,
        {{ image | image_url: width: 2048 }} 2048w
      "
      data-aspectratio="{{ image.aspect_ratio }}"
      data-sizes="auto"
      alt="{{ image.alt | escape }}"
      width="{{ image.width }}"
      height="{{ image.height }}"
      {% if cover %}data-parent-fit="cover"{% endif %}
      {% if image.presentation %}style="object-position: {{ image.presentation.focal_point }}"{% endif %}>

    <noscript>
      {% assign img_url = image | img_url: '1024x1024' %}
      <img src="{{ img_url }}" alt="{{ image.alt | escape }}" class="rimage__image">
    </noscript>
  </div>
</div>
